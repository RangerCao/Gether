# ============================================================
# Gether 配置模板
# 复制到仓库根目录：cp -n infra/.env.example .env
# 说明见 docs/配置与技术选型.md
# ============================================================

# ========== 通用 ==========
# 构建执行层镜像时安装的可选依赖，如 [asr,ocr]
PIP_EXTRAS=
APP_ENV=local
APP_LOG_LEVEL=INFO
APP_API_PREFIX=/internal
APP_TASK_MAX_DURATION_MINUTES=60
DATA_DIR=./data
RAW_MEDIA_TTL_HOURS=24

# ========== 视频源（仅 B站 + YouTube 为一等公民） ==========
VIDEO_SOURCES=bilibili,youtube
BILIBILI_COOKIES_FILE=./secrets/bilibili.cookies.txt
YOUTUBE_COOKIES_FILE=./secrets/youtube.cookies.txt
YTDLP_COOKIES_FILE=
BILIBILI_SUB_LANGS=zh-Hans,zh-CN,zh,ai-zh
YOUTUBE_SUB_LANGS=zh-Hans,zh,en
BILIBILI_MAX_HEIGHT=720
YOUTUBE_MAX_HEIGHT=720
YTDLP_PROXY=
YTDLP_RATE_LIMIT=5M
YTDLP_SLEEP_REQUESTS=1
VIDEO_MAX_DURATION_MINUTES=180
VIDEO_MAX_CONCURRENT_DOWNLOADS=2
PREFER_NATIVE_SUBTITLE=true
STORE_VIDEO=false

# ========== ASR ==========
# 国内下载 faster-whisper 模型可启用镜像
# HF_ENDPOINT=https://hf-mirror.com
ASR_PROVIDER=faster_whisper
ASR_MODEL=small
# 快速模式使用独立 ASR 配置：small + batch 并行（GPU 上更快）
ASR_FAST_MODEL=small
ASR_FAST_BEAM_SIZE=1
ASR_FAST_BATCH_SIZE=8
ASR_FAST_CONCURRENCY=1
ASR_DEVICE=auto
ASR_COMPUTE_TYPE=int8
ASR_LANGUAGE=zh
ASR_BEAM_SIZE=5
ASR_VAD=true
ASR_WORD_TIMESTAMPS=true
ASR_INITIAL_PROMPT=以下是普通话视频内容，请使用简体中文转写，保留专业术语、人名和数字。
ASR_HOTWORDS=
ASR_CONDITION_ON_PREVIOUS_TEXT=false
ASR_VAD_MIN_SILENCE_MS=500
ASR_VAD_SPEECH_PAD_MS=200
ASR_CORRECTION_ENABLED=true
ASR_CORRECTION_BATCH_SIZE=30
ASR_CORRECTION_MAX_CHARS=3000
ASR_CORRECTION_MIN_SIMILARITY=0.2

# ========== 抽帧 / OCR ==========
OCR_ENABLED=true
OCR_PROVIDER=rapidocr
OCR_LANG=ch
OCR_MIN_CONFIDENCE=0.6
FRAME_EXTRACT_MODE=scene
FRAME_SCENE_THRESHOLD=0.3
FRAME_INTERVAL_SECONDS=5
FRAME_MAX_PER_VIDEO=300
FRAME_DEDUP_HAMMING=5
OCR_MERGE_GAP_MS=1500
OCR_ASR_FUSION_ENABLED=true
OCR_ASR_FUSION_MIN_SIMILARITY=0.55
OCR_ASR_FUSION_MIN_CONFIDENCE=0.7

# ========== LLM（选择当前供应商，默认 DeepSeek） ==========
# deepseek | dashscope | openai | ollama | mock
LLM_PROVIDER=deepseek
LLM_FALLBACK_PROVIDER=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL_PLANNER=
LLM_MODEL_CRITIC=
LLM_MODEL_EXTRACT=
LLM_MODEL_WRITER=
LLM_MODEL_ROUTER=
LLM_TEMPERATURE=0.3
LLM_TEMPERATURE_WRITER=0.6
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3
LLM_CONCURRENCY=4
LLM_JSON_MODE=true
LLM_FALLBACK_MODEL=

# --- DeepSeek（LLM_PROVIDER=deepseek 时生效） ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL_DEFAULT=deepseek-chat
DEEPSEEK_MODEL_PLANNER=deepseek-chat
DEEPSEEK_MODEL_CRITIC=deepseek-chat
DEEPSEEK_MODEL_EXTRACT=deepseek-chat
DEEPSEEK_MODEL_WRITER=deepseek-chat
DEEPSEEK_MODEL_ROUTER=deepseek-chat

# --- DashScope / Qwen（LLM_PROVIDER=dashscope 时生效） ---
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL_DEFAULT=qwen-plus
DASHSCOPE_MODEL_PLANNER=qwen-max
DASHSCOPE_MODEL_CRITIC=qwen-plus
DASHSCOPE_MODEL_EXTRACT=qwen-plus
DASHSCOPE_MODEL_WRITER=qwen-max
DASHSCOPE_MODEL_ROUTER=qwen-turbo

# --- OpenAI（可选） ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_DEFAULT=gpt-4o-mini

# --- 本地 / 离线（可选） ---
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL_DEFAULT=qwen2.5:14b

# ========== Embedding / 检索（与 LLM 解耦） ==========
# local | dashscope | openai_compatible | mock
# DeepSeek 无 embedding：用 deepseek 时保持 local，或改用 dashscope
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512
EMBEDDING_API_KEY=
CHUNK_TARGET_CHARS=360
CHUNK_MAX_CHARS=480
CHUNK_OVERLAP_CHARS=60
EMBEDDING_BATCH_SIZE=32
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3
DASHSCOPE_EMBEDDING_DIM=1024
RERANK_ENABLED=false
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RETRIEVAL_TOP_K=10
RETRIEVAL_CANDIDATES=50
RRF_K=40
VECTOR_WEIGHT=1.0
BM25_WEIGHT=1.0
AUTO_INDEX_AFTER_PARSE=true

# ========== PostgreSQL ==========
# DATABASE_URL 非空时覆盖下面分项
DATABASE_URL=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=gether
POSTGRES_USER=gether
POSTGRES_PASSWORD=gether_local_pwd

# ========== MinIO ==========
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=gether
MINIO_SECRET_KEY=gether_local_pwd
MINIO_BUCKET=gether-media

# ========== Redis（可选） ==========
REDIS_URL=redis://localhost:6379/0

# ========== Java 治理层 ==========
SERVER_PORT=8080
EXECUTOR_BASE_URL=http://localhost:8000
EXECUTOR_CONNECT_TIMEOUT_MS=3000
EXECUTOR_READ_TIMEOUT_MS=600000
SSE_TIMEOUT_MS=0
SSE_HEARTBEAT_SECONDS=15
SSE_REPLAY_BUFFER_SIZE=200
TASK_MAX_RETRY=3
CALLBACK_HMAC_SECRET=change_me
JWT_SECRET=change_me

# ========== 前端 ==========
VITE_API_BASE_URL=http://localhost:8080
VITE_SSE_RECONNECT_MS=3000

# ========== 视频发现（P2.6） ==========
DISCOVERY_ENABLED=true
DISCOVERY_SOURCES=bilibili
# api：直连 B站 search/type（推荐）；ytdlp：旧的 bilisearch 方案
DISCOVERY_BILIBILI_SEARCH_MODE=api
DISCOVERY_BILIBILI_COOLDOWN_SECONDS=15
DISCOVERY_SEARCH_CACHE_TTL_SECONDS=3600
# 排序/选择前的全局硬门槛；低于该值或播放量未知的候选直接排除
DISCOVERY_MIN_VIEWS=8000
BILIBILI_MIN_VIEWS=10000
YOUTUBE_MIN_VIEWS=10000
DISCOVERY_FALLBACK_MIN_VIEWS=1000
DISCOVERY_MIN_VIEWS_EXCEPTION=true
DISCOVERY_MIN_ENGAGEMENT_RATE=0.01
DISCOVERY_MAX_VIDEOS=8
DISCOVERY_MIN_VIDEOS=2
DISCOVERY_HARD_MAX_VIDEOS=8
DISCOVERY_DURATION_BUDGET_MIN=180
DISCOVERY_QUERIES_PER_FACET=2
DISCOVERY_SEARCH_RESULTS_PER_QUERY=20
DISCOVERY_METADATA_TOP_N=30
DISCOVERY_MIN_RELEVANCE=0.35
DISCOVERY_MIN_FACET_COVERAGE=0.6
DISCOVERY_MMR_LAMBDA=0.7
DISCOVERY_FRESHNESS_HALF_LIFE_DAYS=180
DISCOVERY_FRESHNESS_WEIGHT=0.15
DISCOVERY_MAX_AGE_DAYS=0
DISCOVERY_FACET_MATCH_THRESHOLD=0.55
DISCOVERY_FACET_MIN_SCORE=0.20
DISCOVERY_SELECT_MIN_SCORE=0.25
DISCOVERY_FACET_LEXICAL_WEIGHT=0.5
DISCOVERY_FACET_EMBEDDING_WEIGHT=0.5
DISCOVERY_SEARCH_RETRIES=2
DISCOVERY_SEARCH_BACKOFF_SECONDS=4
DISCOVERY_QUERY_INTERVAL_SECONDS=4
DISCOVERY_MAX_VIDEO_MINUTES=60

# ========== Java 治理层回调（可选） ==========
GOVERNOR_BASE_URL=
CALLBACK_HMAC_SECRET=change_me

REPORT_REBIND_ENABLED=true
# 快速模式：章节并发生成，跳过 LLM critic 和本地 rebind
# 与 LLM_CONCURRENCY 对齐；DeepSeek 429 会自动退避重试
REPORT_PARALLEL_SECTIONS=4
REPORT_FAST_PARALLEL_ENABLED=true
REPORT_FAST_REBIND_ENABLED=false
REPORT_RERANKER_MODEL=BAAI/bge-reranker-v2-m3-int8
REPORT_RERANKER_CACHE_DIR=D:/DevCache/fastembed_rerank
REPORT_REBIND_THRESHOLD=0.0
REPORT_REBIND_LEXICAL_THRESHOLD=0.45
# 大任务跳过 cross-encoder，避免卡在 90%
REPORT_REBIND_MAX_EVIDENCE=1000
REPORT_REBIND_TIMEOUT_SECONDS=60
